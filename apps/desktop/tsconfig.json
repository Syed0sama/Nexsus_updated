{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "outDir": "../dist-electron",
    "rootDir": ".",
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["*.ts"]
}